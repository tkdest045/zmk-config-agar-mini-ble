#include "./boards/shields/klink_kbd/common.keymap"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "tap-preferred"; // change hold to tap
    tapping-term-ms = <250>; // 連続タップ
    quick-tap-ms = <200>;
};

&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <250>;
    quick-tap-ms = <200>;
};

/ { 
    combos {
        compatible = "zmk,combos";

        backspace {
            bindings = <&kp BSPC>;
            key-positions = <8 9>;
            layers = <0 3>;
        };

        delete {
            bindings = <&kp DEL>;
            key-positions = <5 6>;
            layers = <0 3>;
        };

        rightbracket {
            bindings = <&kp LS(N9)>;
            key-positions = <6 7>;
            layers = <0>;
        };

        leftbracket {
            bindings = <&kp LS(N0)>;
            key-positions = <7 8>;
            layers = <0>;
        };

        rightbracket2 {
            bindings = <&kp LBKT>;
            key-positions = <8 9>;
            layers = <0>;
        };

        leftbracket2 {
            bindings = <&kp RBKT>;
            key-positions = <9 10>;
            layers = <0>;
        };

        rightbracket3 {
            bindings = <&kp LBRC>;
            key-positions = <10 11>;
            layers = <0>;
        };

        leftbracket3 {
            bindings = <&kp RBRC>;
            key-positions = <11 12>;
            layers = <0>;
        };

        gui_space {
            bindings = <&kp LANG2>;
            key-positions = <39 40>;
            layers = <0>;
        };

        grave {
            bindings = <&kp GRAVE>;
            key-positions = <15 16>;
            layers = <0>;
        };

        dash {
            bindings = <&kp MINUS>;
            key-positions = <20 21>;
            layers = <0>;
        };

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <21 22>;
            layers = <0>;
        };

        quote {
            bindings = <&kp SQT>;
            key-positions = <22 23>;
            layers = <0>;
        };

        tilde {
            bindings = <&kp LS(GRAVE)>;
            key-positions = <27 28>;
            layers = <0>;
        };

        underscore {
            bindings = <&kp LS(MINUS)>;
            key-positions = <28 29>;
            layers = <0>;
        };

        plus {
            bindings = <&kp LS(EQUAL)>;
            key-positions = <29 30>;
            layers = <0>;
        };

        backslash {
            bindings = <&kp BSLH>;
            key-positions = <30 31>;
            layers = <0>;
        };

        boot_combo {
            bindings = <&bootloader>;
            key-positions = <20 31>;
            layers = <1 3>;
        };

        n0_combo {
            bindings = <&kp N0>;
            key-positions = <37 38>;
            layers = <0>;
        };

        n1_combo {
            bindings = <&kp N1>;
            key-positions = <26 27>;
            layers = <0>;
        };

        n2_combo {
            bindings = <&kp N2>;
            key-positions = <27 28>;
            layers = <0>;
        };

        n3_combo {
            bindings = <&kp N3>;
            key-positions = <28 29>;
            layers = <0>;
        };

        n4_combo {
            bindings = <&kp N4>;
            key-positions = <14 15>;
            layers = <0>;
        };

        n5_combo {
            bindings = <&kp N5>;
            key-positions = <15 16>;
            layers = <0>;
        };

        n6_combo {
            bindings = <&kp N6>;
            key-positions = <16 17>;
            layers = <0>;
        };

        n7_combo {
            bindings = <&kp N7>;
            key-positions = <1 2>;
            layers = <0>;
        };

        n8_combo {
            bindings = <&kp N8>;
            key-positions = <2 3>;
            layers = <0>;
        };

        n9_combo {
            bindings = <&kp N9>;
            key-positions = <3 4>;
            layers = <0>;
        };
    };



/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BASE";
            bindings = <
&kp ESCAPE &kp Q      &kp W     &kp E  &kp R        &kp T  &kp Y      &kp U  &kp I      &kp O           &kp P                &mt DEL           &kp BSPC
&kp TAB    &kp A      &kp S     &kp D  &kp F        &kp G  &kp H      &kp J  &kp K      &kp L           &kp SEMI             &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C  &kp V        &kp B  &kp N      &kp M  &kp COMMA  &kp DOT         &kp SLASH            &mt LSHIFT LANG2
           &kp LALT   &kp LGUI         &lt 1 SPACE         &lt 2 ENTER                  &kp LGUI        &kp LCTRL
            >;
        };

        layer1 {
            display-name = "ARROW";
            bindings = <
&trans      &none           &kp HOME    &kp UP       &kp END      &none     &none     &kp LG(LC(N3))   &kp LG(LC(N4))  &kp LG(LC(N5)) &none        &kp C_VOL_DN  &kp C_VOL_UP
&trans      &none           &kp LEFT    &kp DOWN     &kp RIGHT    &none     &none     &kp LG(EQUAL)    &kp(MINUS)      &none          &none        &kp C_MUTE
&trans      &kp LG(Z)       &kp LG(X)   &kp LG(C)    &kp LG(V)    &none     &none     &none            &none           &none          &bt BT_SEL 1 &bootloader
            &kp LG(LS(Z))   &trans                   &mo 1                  &kp LSHIFT                 &kp LALT        &kp LCTRL
            >;
        };

        layer2 {
            display-name = "NSYMBOL";
            bindings = <
&trans        &kp EXCL         &kp AT          &kp HASH      &kp DLLR       &kp PRCNT    &kp CARET    &kp AMPS         &kp STAR    &kp LPAR    &kp RPAR    &trans    &trans
&trans        &kp N1           &kp N2          &kp N3        &kp N4         &kp N5       &kp GRAVE    &kp MINUS        &kp EQUAL   &kp LBKT    &kp RBKT    &kp BSLH
&kp CAPSLOCK  &kp N6           &kp N7          &kp N8        &kp N9         &kp N0       &kp TILDE    &kp UNDERSCORE   &kp PLUS    &kp LBRC    &kp RBRC    &kp PIPE
              &trans           &trans                    &trans             &mo 2                     &trans           &trans
            >;
        };

        layer3 {
            bindings = <
&trans  &kp F1  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans      &trans        &trans            &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans      &trans        &kp C_PLAY_PAUSE
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp C_PREV  &kp C_NEXT  &kp C_VOL_UP  &trans
        &trans  &trans          &trans          &trans                      &kp C_MUTE  &kp C_VOL_DN
            >;
        };

        layer4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans          &trans          &trans                  &trans  &trans
            >;
        };

        layer5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans          &trans          &trans                  &trans  &trans
            >;
        };

        layer6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans          &trans          &trans                  &trans  &trans
            >;
        };

        layer7 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans          &trans          &trans                  &trans  &trans
            >;
        };
    };
};
