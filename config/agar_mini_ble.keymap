#include "./boards/shields/klink_kbd/common.keymap"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "tap-preferred"; // change hold to tap
    tapping-term-ms = <250>; // 連続タップ
    quick-tap-ms = <200>;
};

&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <250>;
    quick-tap-ms = <200>;
};

/ { 
    combos {
        compatible = "zmk,combos";

        bootloader {
            bindings = <&bootloader>;
            key-positions = <22 30>;
            layers = <1 2>;
        };

        BT_0 {
            bindings = <&bt BT_SEL 0>;
            key-positions = <5 30>;
            layers = <1>;
        };

        BT_1 {
            bindings = <&bt BT_SEL 1>;
            key-positions = <5 30>;
            layers = <2>;
        };

        n0_combo {
            bindings = <&kp N0>;
            key-positions = <25 26>;
            layers = <0>;
        };

        n1_combo {
            bindings = <&kp N1>;
            key-positions = <26 27>;
            layers = <0>;
        };

        n2_combo {
            bindings = <&kp N2>;
            key-positions = <27 28>;
            layers = <0>;
        };

        n3_combo {
            bindings = <&kp N3>;
            key-positions = <28 29>;
            layers = <0>;
        };

        n4_combo {
            bindings = <&kp N4>;
            key-positions = <14 15>;
            layers = <0>;
        };

        n5_combo {
            bindings = <&kp N5>;
            key-positions = <15 16>;
            layers = <0>;
        };

        n6_combo {
            bindings = <&kp N6>;
            key-positions = <16 17>;
            layers = <0>;
        };

        n7_combo {
            bindings = <&kp N7>;
            key-positions = <1 2>;
            layers = <0>;
        };

        n8_combo {
            bindings = <&kp N8>;
            key-positions = <2 3>;
            layers = <0>;
        };

        n9_combo {
            bindings = <&kp N9>;
            key-positions = <3 4>;
            layers = <0>;
        };

        shift_combo {
            bindings = <&kp LSHIFT>;
            key-positions = <39 40>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BASE";
            bindings = <
&kp ESCAPE  &kp Q      &kp W     &kp E  &kp R        &kp T  &kp Y      &kp U  &kp I      &kp O           &kp P                &kp BSPC           &kp DEL
&kp TAB     &kp A      &kp S     &kp D  &kp F        &kp G  &kp H      &kp J  &kp K      &kp L           &kp SEMI             &kp SQT
&kp LSHIFT  &kp Z      &kp X     &kp C  &kp V        &kp B  &kp N      &kp M  &kp COMMA  &kp DOT         &kp SLASH            &kp LSHIFT
            &kp LCTRL   &mo 4         &lt 1 SPACE         &lt 2 LS(ENTER)               &mo 3        &kp LALT
            >;
        };

        layer1 {
            display-name = "ARROW";
            bindings = <
&trans      &none           &kp HOME        &kp UP          &kp END          &none     &none         &kp C_VOL_DN     &kp C_VOL_UP   &kp C_MUTE  &none      &none    &none
&trans      &none           &kp LEFT        &kp DOWN        &kp RIGHT        &none     &kp LS(LALT)  &kp LSHIFT       &kp LGUI       &kp LALT    &kp LCTRL  &none
&trans      &none           &kp LG(LS(N3))  &kp LG(LS(N4))  &kp LG(LS(N5))   &none     &none         &kp LG(MINUS)    &kp LG(EQUAL)  &none       &none      &none
            &trans          &kp LGUI          &mo 1                 &lt 5 LG(SPACE)            &kp LGUI         &trans
            >;
        };

        layer2 {
            display-name = "NSYMBOL";
            bindings = <
&kp GRAVE     &kp EXCL         &kp AT          &kp HASH      &kp DLLR       &kp PRCNT    &kp CARET    &kp AMPS         &kp STAR    &kp LPAR    &kp RPAR    &trans    &trans
&kp TILDE     &kp N1           &kp N2          &kp N3        &kp N4         &kp N5       &kp TILDE    &kp MINUS        &kp EQUAL   &kp LBKT    &kp RBKT    &kp BACKSLASH
&kp CAPSLOCK  &kp N6           &kp N7          &kp N8        &kp N9         &kp N0       &kp GRAVE    &kp UNDERSCORE   &kp PLUS    &kp LBRC    &kp RBRC    &kp LS(BACKSLASH)
              &trans           &kp LGUI                    &kp LG(ENTER)          &mo 2                     &kp LGUI           &trans
            >;
        };

        layer3 {
            display-name = "LGUI";
            bindings = <
&kp LG(GRAVE) &kp LG(Q)     &kp LG(W)     &kp LG(E)  &kp LG(R)        &kp LG(T)  &kp LG(Y)      &kp LG(U)  &kp LG(I)      &kp LG(O)           &kp LG(P)                &kp BSPC           &kp DEL
&kp LG(TILDE) &kp LG(A)     &kp LG(S)     &kp LG(D)  &kp LG(F)        &kp LG(G)  &kp LG(H)      &kp LG(J)  &kp LG(K)      &kp LG(L)           &kp LG(SEMI)             &kp LG(SQT)
&kp LSHIFT    &kp LG(Z)     &kp LG(X)     &kp LG(C)  &kp LG(V)        &kp LG(B)  &kp LG(N)      &kp LG(M)  &kp LG(COMMA)  &kp LG(DOT)         &kp LG(SLASH)            &kp LSHIFT
                   &kp LCTRL     &kp LSHIFT          &kp SPACE        &kp LS(ENTER)             &mo 3             &kp LALT
            >;
        };

        layer4 {
            display-name = "RGUI";
            bindings = <
&kp LG(GRAVE) &kp LG(Q)     &kp LG(W)     &kp LG(E)  &kp LG(R)        &kp LG(T)  &kp LG(Y)      &kp LG(U)  &kp LG(I)      &kp LG(O)           &kp LG(P)                &kp BSPC           &kp DEL
&kp LG(TILDE) &kp LG(A)     &kp LG(S)     &kp LG(D)  &kp LG(F)        &kp LG(G)  &kp LG(H)      &kp LG(J)  &kp LG(K)      &kp LG(L)           &kp LG(SEMI)             &kp LG(SQT)
&kp LSHIFT    &kp LG(Z)     &kp LG(X)     &kp LG(C)  &kp LG(V)        &kp LG(B)  &kp LG(N)      &kp LG(M)  &kp LG(COMMA)  &kp LG(DOT)         &kp LG(SLASH)            &kp LSHIFT
                   &kp LCTRL     &mo 4               &kp SPACE        &kp LS(ENTER)             &kp LSHIFT        &kp LALT
            >;
        };

        layer5 {
            display-name = "SHIFT";
            bindings = <
&kp GRAVE     &kp LS(Q)     &kp LS(W)     &kp LS(E)  &kp LS(R)    &kp LS(T)  &kp LS(Y)      &kp LS(U)  &kp LS(I)      &kp LS(O)           &kp LS(P)                &kp BSPC           &kp DEL
&kp TILDE     &kp LS(A)     &kp LS(S)     &kp LS(D)  &kp LS(F)    &kp LS(G)  &kp LS(H)      &kp LS(J)  &kp LS(K)      &kp LS(L)           &kp LS(SEMI)             &kp LS(SQT)
&kp LSHIFT    &kp LS(Z)     &kp LS(X)     &kp LS(C)  &kp LS(V)    &kp LS(B)  &kp LS(N)      &kp LS(M)  &kp LS(COMMA)  &kp LS(DOT)         &kp LS(SLASH)            &kp LSHIFT
                   &none      &none               &mo 5        &mo 5             &none         &none
            >;
        };
    };
};
