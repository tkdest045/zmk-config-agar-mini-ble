#include "./boards/shields/klink_kbd/common.keymap"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "tap-preferred"; // change hold to tap
    tapping-term-ms = <250>; // 連続タップ
    quick-tap-ms = <200>;
};

&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <250>;
    quick-tap-ms = <200>;
};

/ { 
    combos {
        compatible = "zmk,combos";

        bootloader {
            bindings = <&bootloader>;
            key-positions = <0 36>;
            layers = <1 2>;
        };

        BT_0 {
            bindings = <&bt BT_SEL 0>;
            key-positions = <13 36>;
            layers = <1 2>;
        };

        BT_1 {
            bindings = <&bt BT_SEL 1>;
            key-positions = <25 36>;
            layers = <1 2>;
        };

        n0_combo {
            bindings = <&kp N0>;
            key-positions = <25 26>;
            layers = <0>;
        };

        n1_combo {
            bindings = <&kp N1>;
            key-positions = <26 27>;
            layers = <0>;
        };

        n2_combo {
            bindings = <&kp N2>;
            key-positions = <27 28>;
            layers = <0>;
        };

        n3_combo {
            bindings = <&kp N3>;
            key-positions = <28 29>;
            layers = <0>;
        };

        n4_combo {
            bindings = <&kp N4>;
            key-positions = <14 15>;
            layers = <0>;
        };

        n5_combo {
            bindings = <&kp N5>;
            key-positions = <15 16>;
            layers = <0>;
        };

        n6_combo {
            bindings = <&kp N6>;
            key-positions = <16 17>;
            layers = <0>;
        };

        n7_combo {
            bindings = <&kp N7>;
            key-positions = <1 2>;
            layers = <0>;
        };

        n8_combo {
            bindings = <&kp N8>;
            key-positions = <2 3>;
            layers = <0>;
        };

        n9_combo {
            bindings = <&kp N9>;
            key-positions = <3 4>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BASE";
            bindings = <
&kp ESCAPE &kp Q      &kp W     &kp E  &kp R        &kp T  &kp Y      &kp U  &kp I      &kp O           &kp P                &kp BSPC           &kp DEL
&kp TAB    &kp A      &kp S     &kp D  &kp F        &kp G  &kp H      &kp J  &kp K      &kp L           &kp SEMI             &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C  &kp V        &kp B  &kp N      &kp M  &kp COMMA  &kp DOT         &kp SLASH            &mt LSHFT SLASH
           &kp LCTRL   &kp LGUI         &lt 1 SPACE         &lt 2 ENTER                 &kp LGUI        &kp LALT
            >;
        };

        layer1 {
            display-name = "ARROW";
            bindings = <
&trans      &none           &kp HOME        &kp UP          &kp END          &none     &none     &kp C_VOL_DN     &kp C_VOL_UP   &kp C_MUTE  &none      &none    &none
&trans      &none           &kp LEFT        &kp DOWN        &kp RIGHT        &none     &none     &kp LSHFT        &kp LGUI       &kp LALT    &kp LCTRL  &none
&trans      &none           &kp LG(LS(N3))  &kp LG(LS(N4))  &kp LG(LS(N5))   &none     &none     &kp LG(MINUS)    &kp LG(EQUAL)  &none       &none      &none
            &trans          &trans          &mo 1                 &kp LG(SPACE)            &trans         &trans
            >;
        };

        layer2 {
            display-name = "NSYMBOL";
            bindings = <
&kp GRAVE     &kp EXCL         &kp AT          &kp HASH      &kp DLLR       &kp PRCNT    &kp CARET    &kp AMPS         &kp STAR    &kp LPAR    &kp RPAR    &trans    &trans
&kp TILDE     &kp N1           &kp N2          &kp N3        &kp N4         &kp N5       &none        &kp MINUS        &kp EQUAL   &kp LBKT    &kp RBKT    &kp LS(ENTER)
&kp CAPSLOCK  &kp N6           &kp N7          &kp N8        &kp N9         &kp N0       &none        &kp UNDERSCORE   &kp PLUS    &kp LBRC    &kp RBRC    &kp LA(ENTER)
              &trans           &trans                    &kp SPACE          &mo 2                     &trans           &trans
            >;
        };

    };
};
